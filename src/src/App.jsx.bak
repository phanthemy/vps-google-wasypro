                      }}
                      className="btn btn-secondary text-xs" style={{ padding: '0.25rem 0.5rem' }}>ChÃƒÂ¡Ã‚Â»Ã¢â‚¬Â°nh sÃƒÂ¡Ã‚Â»Ã‚Â­a</button>
                  </td>
