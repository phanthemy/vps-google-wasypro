                        if (newPass && newPass.length >= 3) {
                          const res = await fetch(`/api/internal-users/${u.userId}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ password: newPass })
