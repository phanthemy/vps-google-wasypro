// This is your Prisma schema file
//
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String   @unique
  password  String   @default("123456")
  cccd      String?
  bankInfo  String?
  tier      String   @default("SILVER") // DIAMOND, GOLD, SILVER
  role      String   @default("ctv") // admin, accountant, ctv
  parentId  String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  mustChangePassword Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      String?

  // Phase 2A: Foundation rank & S-Points fields
  rank              String?   // AMBASSADOR, SALES_MANAGER, SALES_DIRECTOR, EXEC_OPERATIONS, EXEC_PROVINCE, EXEC_STRATEGIC
  rankStatus        String?   // NOT_QUALIFIED, AUTO_QUALIFIED, ACTIVE_RANK, MANUAL_APPROVED, REVOKED
  rankAchievedAt    DateTime?
  regionCode        String?   // M? v?ng/t?nh ph? tr?ch
  sPoints           Float     @default(0)   // T?ng ?i?m S t?ch l?y hi?n c?
  wholesaleEligible Boolean   @default(false)
  totalMachinesBought Int     @default(0)   // T?ng s? l?n t? mua (isSelfBuy=true) t?ch l?y

  // Phase 2B: Ambassador activation audit
  rankActivationMethod String? // AUTO_MACHINE_PURCHASE | AUTO_SPOINT_THRESHOLD | ADMIN_MANUAL_APPROVE
  rankActivatedBy      String? // userId admin n?u manual approve, null n?u auto

  // Phase 2C: Participant status & BusinessId (FINAL SPEC v3.6)
  isSystemParticipant  Boolean   @default(false)
  businessId           String?   @unique
  participantAt        DateTime?
  qualifyingPoints     Int       @default(0)

  parent      User?         @relation("UserToUser", fields: [parentId], references: [userId])
  children    User[]        @relation("UserToUser")
  customers   Customer[]    @relation("LegacyCustomerSource")
  commissions Commission[]
  sPointTransactions SPointTransaction[]
  wholesaleOrders    WholesaleOrder[]   @relation("WholesaleBuyer")
  rankHistories      RankHistory[]

  // Phase 2C relations
  sponsoredCustomers Customer[] @relation("CustomerSponsor")
  linkedCustomers    Customer[] @relation("CustomerLinked")
  createdOrders      Order[]    @relation("OrderCreator")
}

model Customer {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   // Can store full phone or last 4 digits
  sourceCtvId  String
  status       String   @default("NEW") // NEW, APPOINT_BOOKED, ARRIVED, EXPIRED
  registeredAt DateTime @default(now())
  expiresAt    DateTime // usually registeredAt + 30 days
  updatedAt    DateTime @updatedAt

  // Phase 2C: Direct sponsor & Linked user account (FINAL SPEC v3.6)
  sponsorUserId String?
  linkedUserId  String?  @unique

  sourceCtv    User     @relation("LegacyCustomerSource", fields: [sourceCtvId], references: [userId])
  sponsorUser  User?    @relation("CustomerSponsor", fields: [sponsorUserId], references: [id])
  linkedUser   User?    @relation("CustomerLinked", fields: [linkedUserId], references: [id])

  appointments Appointment[]
  orders       Order[]
  auditLogs    CustomerAuditLog[]

  @@unique([phone, sourceCtvId]) // A CTV can't register the same phone twice
}

model CustomerAuditLog {
  id         String   @id @default(cuid())
  customerId String
  userId     String   // The admin/accountant who made the change
  action     String   // e.g., 'UPDATE_STATUS'
  details    String   // JSON string of changes (from -> to)
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
}

model Appointment {
  id          String   @id @default(cuid())
  customerId  String
  date        DateTime
  status      String   @default("PENDING") // PENDING, ARRIVED, CANCELLED
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "N?i khoa", "Ph?u thu?t", "Ch?m s?c"

  services    Service[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  categoryId  String
  group       String?

  price       Float
  description String?
  imageUrl    String?

  // Phase 2A: Product type for S-Points and wholesale classification
  productType String?   // MACHINE, SUPPLY, SERVICE ? null = ch?a ph?n lo?i (c?n admin set)
  listPrice   Float?    // Gi? ni?m y?t (null = d?ng price)

  // Phase 2C: Commission Points independent from price (FINAL SPEC v3.6) - Integer representation
  commissionPoints Int   @default(0)

  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  wholesaleItems WholesaleOrderItem[] @relation("WholesaleItems")
}

model Order {
  id          String   @id @default(cuid())
  customerId  String
  totalAmount Float
  status      String   @default("COMPLETED") // DEPOSIT, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())

  // Phase 2B: Order classification
  orderType   String   @default("RETAIL")  // RETAIL
  isSelfBuy   Boolean  @default(false)     // buyer.phone == customer.phone

  // Phase 2C: Purchase Type & Orderer Attribution (FINAL SPEC v3.6)
  purchaseType  String   @default("CUSTOMER_PURCHASE") // SELF_PURCHASE | CUSTOMER_PURCHASE
  ordererUserId String?

  // Period Lifecycle: gắn order với kỳ hoa hồng
  periodId    String?  // null = pre-period (legacy data)

  customer    Customer    @relation(fields: [customerId], references: [id])
  orderer     User?       @relation("OrderCreator", fields: [ordererUserId], references: [id])
  period      CommissionPeriod? @relation(fields: [periodId], references: [id])
  items       OrderItem[]
  commissions Commission[]
  commissionProcessing CommissionProcessing?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  serviceId String?
  productId String?
  amount    Float    // actual paid amount
  qty       Int      @default(1)

  // Phase 2C: Commission Points snapshot at order time (FINAL SPEC v3.6) - Integer representation
  unitCommissionPts Int @default(0)
  lineCommissionPts Int @default(0)

  order     Order    @relation(fields: [orderId], references: [id])
  service   Service? @relation(fields: [serviceId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
}

model Commission {
  id          String   @id @default(cuid())
  orderId     String
  receiverId  String
  amount      Float
  type        String   // DIRECT, OVERRIDE_F1, OVERRIDE_F2, SELF_CONSUMPTION, DIRECT_RETAIL, DISTRIBUTION_PARTNER, REGIONAL_DEVELOPMENT
  status      String   @default("PENDING") // PENDING, PAID
  createdAt   DateTime @default(now())

  // Phase 2B: Audit snapshot fields
  rateSnapshot Float?   // % rate applied at time of calculation
  rankSnapshot String?  // receiver rank at time of calculation
  baseAmount   Float?   // amount before rate multiplication
  policyRef    String?  // Rule ID: AM-01, AM-02, AM-03, AM-04, DIRECT, OVERRIDE_F1, OVERRIDE_F2
  metadata     String?  // JSON: additional rule details (ancestor depth, rule match, etc.)

  // Phase 2C: Mandatory 6 audit snapshot fields (FINAL SPEC v3.6) - Integer point/money representation
  ruleKey       String?  // Exact rule key applied: e.g. AMBASSADOR_SELF_BUY, MANAGER_F1_PURCHASE
  policyVersion String?  // Policy version snapshot: e.g. 1.0.0 or 09/2026-v1
  role          String?  // Role in transaction: SELF, DIRECT_SPONSOR, UPSTREAM_D1, UPSTREAM_D2
  basePoints    Int?     // Base integer points used for calculation (orderTotalCP or split points)
  earnedPoints  Int?     // Calculated integer points: Math.round(basePoints * rateSnapshot)
  earnedMoney   Int?     // Calculated integer VND: earnedPoints * 1000

  // Period Lifecycle: gắn commission với kỳ hoa hồng
  periodId    String?  // null = pre-period (legacy data)

  order       Order    @relation(fields: [orderId], references: [id])
  receiver    User     @relation(fields: [receiverId], references: [userId])
  period      CommissionPeriod? @relation(fields: [periodId], references: [id])
}

// Phase 2A ? Migration 3: S-Point Transaction log
model SPointTransaction {
  id          String   @id @default(cuid())
  userId      String
  orderId     String?  // Link to order that generated the points (nullable for adjustments)
  points      Float    // Positive = earn, Negative = redeem/deduct
  type        String   // EARN, REDEEM, EXPIRE, ADJUST
  description String?
  createdAt   DateTime @default(now())

  // Phase 2C: Qualifying audit fields (FINAL SPEC v3.6)
  isQualifying    Boolean @default(false)
  snapshotBalance Float?
  policyVersion   String?

  user        User     @relation(fields: [userId], references: [userId])
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  icon        String?
  products    Product[]
}

model Product {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  categoryId    String
  price         Float    @default(0)
  originalPrice Float?
  rating        Float    @default(5)
  reviewsCount  Int      @default(0)
  image         String?
  gallery       String?  // JSON array string
  description   String?
  specs         String?  // JSON string of ProductSpecs
  isHot         Boolean  @default(false)
  isNew         Boolean  @default(false)
  stock         Int      @default(0)
  promotion     String?  // Gift/promotion text e.g. "T?ng b? l?c th? tr? gi? 500k"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Phase 2C: Commission Points independent from price (FINAL SPEC v3.6) - Integer representation
  commissionPoints Int   @default(0)
  orderItems        OrderItem[]

  category      ProductCategory @relation(fields: [categoryId], references: [id])
}

model WebsiteOrder {
  id            String   @id @default(cuid())
  customerName  String
  customerPhone String
  address       String?
  message       String?
  type          String   @default("ORDER") // ORDER, CONSULTATION
  productId     String?
  productTitle  String?
  productPrice  Float    @default(0)
  qty           Int      @default(1)
  totalAmount   Float    @default(0)
  status        String   @default("NEW") // NEW, CONFIRMED, SHIPPING, COMPLETED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 2B ? Migration 2B-4: Configurable retail commission rules engine
model CommissionPriceRule {
  id           String   @id @default(cuid())
  productType  String   // MACHINE, SUPPLY, SERVICE
  minPrice     Float?   // null = no lower bound
  maxPrice     Float?   // null = no upper bound
  rate         Float?   // null = TBD/CONFIGURABLE (inactive rules)
  commType     String   // Commission type to create: DIRECT_RETAIL, etc.
  rankRequired String?  // AMBASSADOR, null = any rank
  isActive     Boolean  @default(true)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Phase 2B ? Migration 2B-5a: Wholesale order module
model WholesaleOrder {
  id             String   @id @default(cuid())
  buyerUserId    String
  totalMachines  Int
  discountRate   Float            // 0.35 | 0.40 | 0.45
  basePriceType  String   @default("PRICE")  // PRICE ? chot (MAU_THUAN_03)
  priceTotal     Float            // Total service.price before discount (snapshot)
  listPriceTotal Float?           // Total listPrice for reference
  finalAmount    Float            // Total after discount = priceTotal * (1 - discountRate)
  status         String   @default("PENDING_APPROVAL")
  approvedBy     String?
  approvedAt     DateTime?
  shippedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  buyer User                @relation("WholesaleBuyer", fields: [buyerUserId], references: [userId])
  items WholesaleOrderItem[]
}

model WholesaleOrderItem {
  id               String         @id @default(cuid())
  wholesaleOrderId String
  serviceId        String
  qty              Int
  unitPrice        Float          // service.price snapshot at order time (BASE)
  unitListPrice    Float?         // service.listPrice snapshot (reference only)
  discountRate     Float          // 0.35 | 0.40 | 0.45
  discountedPrice  Float          // unitPrice * (1 - discountRate)
  subtotal         Float          // discountedPrice * qty

  wholesaleOrder WholesaleOrder @relation(fields: [wholesaleOrderId], references: [id])
  service        Service        @relation("WholesaleItems", fields: [serviceId], references: [id])
}

// Phase 2B ? Migration 2B-5b: Rank change history for full audit trail
model RankHistory {
  id          String   @id @default(cuid())
  userId      String
  fromRank    String?  // null if first time achieving rank
  toRank      String
  fromStatus  String?
  toStatus    String
  reason      String   // AUTO_MACHINE_PURCHASE | AUTO_SPOINT_THRESHOLD | ADMIN_MANUAL_APPROVE | ADMIN_REVOKE
  triggeredBy String?  // admin userId or SYSTEM
  metadata    String?  // JSON snapshot: machinesBoughtAtTime, sPointsAtTime, approvalNote, revokeReason
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])
}

// Phase 2C → Migration 2C-1: Idempotency table for Commission Processing (FINAL SPEC v3.6)
model CommissionProcessing {
  id            String   @id @default(cuid())
  orderId       String   @unique
  status        String   @default("COMPLETED")
  processedAt   DateTime @default(now())
  policyVersion String   @default("1.0.0")

  // Period Lifecycle
  periodId        String?
  policySetVersion String?  // e.g. "09/2026-v2"

  order  Order             @relation(fields: [orderId], references: [id])
  period CommissionPeriod? @relation(fields: [periodId], references: [id])
}

// Phase 2C ? Migration 2C-2: BusinessId Sequence table (SQLite-safe auto-increment)
model BusinessIdSequence {
  id      Int @id @default(1)
  nextVal Int @default(10000)
}

// Phase 2C ? Migration 2C-3: Dynamic System Policy Config (FINAL SPEC v3.6)
model SystemPolicyConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  version     String   @default("1.0.0")
  updatedBy   String?  // User ID or ADMIN who updated the policy
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs   SystemPolicyAuditLog[]
}

// Phase 2C ? Migration 2C-4: System Policy Audit History (FINAL SPEC v3.6 ? IX.3)
model SystemPolicyAuditLog {
  id          String   @id @default(cuid())
  policyId    String
  key         String
  oldValue    String?
  newValue    String
  version     String
  updatedBy   String?
  createdAt   DateTime @default(now())

  policy      SystemPolicyConfig @relation(fields: [policyId], references: [id])
  reason      String?
}

// Phase 2C ? Migration 2C-5: Product/Service Commission Points Audit History (FINAL SPEC v3.6)
model CommissionPointAuditLog {
  id         String   @id @default(cuid())
  itemType   String   // 'PRODUCT' | 'SERVICE'
  itemId     String
  itemName   String?
  oldValue   Int?
  newValue   Int
  actor      String?  // userId or email
  reason     String?
  createdAt  DateTime @default(now())
}

// ─── Period Lifecycle ───────────────────────────────────────────────────────

// Period Lifecycle: Kỳ hoa hồng
model CommissionPeriod {
  id          String   @id @default(cuid())
  periodName  String   // e.g. "09/2026", "10/2026"
  startAt     DateTime
  endAt       DateTime
  status      String   @default("OPEN") // OPEN | CLOSED
  createdAt   DateTime @default(now())
  createdBy   String   // userId admin
  closedAt    DateTime?
  closedBy    String?  // userId admin

  policies             PeriodPolicyConfig[]
  orders               Order[]
  commissions          Commission[]
  commissionProcessing CommissionProcessing[]
  closeAudit           PeriodCloseAudit?
}

// Period Lifecycle: Policy gắn theo kỳ
model PeriodPolicyConfig {
  id            String   @id @default(cuid())
  periodId      String
  key           String
  value         String   // rate 0.00-1.00 | integer (THRESHOLD) | "NOT_CONFIGURED"
  description   String?
  version       String   // e.g. "09/2026-v1", "09/2026-v2"
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  effectiveFrom DateTime @default(now())

  period    CommissionPeriod     @relation(fields: [periodId], references: [id])
  auditLogs PeriodPolicyAuditLog[]

  @@unique([periodId, key])
}

// Period Lifecycle: Audit log thay đổi policy theo kỳ
model PeriodPolicyAuditLog {
  id            String   @id @default(cuid())
  policyId      String
  periodId      String
  key           String
  oldValue      String?
  newValue      String
  version       String
  updatedBy     String?
  updatedAt     DateTime @default(now())
  reason        String?
  effectiveFrom DateTime?

  policy PeriodPolicyConfig @relation(fields: [policyId], references: [id])
}

// Period Lifecycle: Audit khi chốt kỳ
model PeriodCloseAudit {
  id                String   @id @default(cuid())
  periodId          String   @unique
  closedBy          String
  closedAt          DateTime @default(now())
  oldStatus         String
  newStatus         String
  totalOrders       Int      @default(0)
  totalCommissions  Int      @default(0)
  totalEarnedPoints Int      @default(0)
  totalEarnedMoney  Int      @default(0)
  metadata          String?  // JSON

  period CommissionPeriod @relation(fields: [periodId], references: [id])
}
